# Copy to backend/.env for local development. Never commit .env.
APP_ENV=development
HTTP_ADDR=:8080

# golang-migrate URL or a native go-sql-driver DSN. The app normalises it to
# UTC + utf8mb4 + parseTime.
DATABASE_URL=mysql://root:password@tcp(127.0.0.1:3306)/kodi_demo

# Required outside development. Lockouts, JWT revocation and authz versions
# must be shared by every API instance; development may omit it and use memory.
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# At least 32 characters. Required outside development.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
TOKEN_ISSUER=kodipms
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Web app origin(s), comma separated. Outside development both CORS_ORIGINS
# and PUBLIC_BASE_URL are required, must be https, and must not be localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:5173

# Password reset and invite delivery. Required outside development; in
# development leave both unset and the link is logged instead of emailed.
# Use port 587 (STARTTLS); implicit TLS on 465 is not supported.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=no-reply@example.com

# Refresh cookie. Defaults to true outside development and must stay true there.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Set true only behind a reverse proxy that appends/overwrites
# X-Forwarded-For and X-Forwarded-Host. The rightmost forwarded hop is used.
TRUST_PROXY=false
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=600
SHUTDOWN_TIMEOUT=10s
