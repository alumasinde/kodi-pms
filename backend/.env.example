# Copy to backend/.env for local development. Never commit .env.
APP_ENV=development
HTTP_ADDR=:8080

# golang-migrate URL or a native go-sql-driver DSN. The app normalises it to
# UTC + utf8mb4 + parseTime.
DATABASE_URL=mysql://root:password@tcp(127.0.0.1:3306)/kodi_demo

# Optional. Without it the API uses an in-process cache (single instance only).
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# At least 32 characters. Required outside development.
JWT_SECRET=change-me-to-a-long-random-string-0123456789
TOKEN_ISSUER=kodipms
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Web app origin(s), comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_BASE_URL=http://localhost:5173

# Refresh cookie. Secure must be true behind HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Set true only behind a reverse proxy that overwrites X-Forwarded-For/Host.
TRUST_PROXY=false
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=600
SHUTDOWN_TIMEOUT=10s
